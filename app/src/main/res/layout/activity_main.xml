<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <!-- WebView - 主要内容区域 -->
    <WebView
        android:id="@+id/webview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"/>

    <!-- 加载状态提示层 -->
    <RelativeLayout
        android:id="@+id/loading_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#FFFFFF"> <!-- 白色加载背景 -->

        <!-- 加载动画 -->
        <ProgressBar
            android:id="@+id/progress_bar"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:layout_centerInParent="true"
            android:indeterminateTint="#3964FE"
            android:indeterminate="true"
            style="@android:style/Widget.ProgressBar.Large"/>

        <!-- 加载提示文本 -->
        <TextView
            android:id="@+id/loading_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/progress_bar"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="20dp"
            android:text="正在加载内容，请稍候..."
            android:textColor="#000000"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"/>

        <!-- 倒计时提示 -->
        <TextView
            android:id="@+id/countdown_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/loading_text"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="10dp"
            android:text=""
            android:textColor="#888888"
            android:textSize="18sp"/>

        <!-- 错误提示视图 -->
        <LinearLayout
            android:id="@+id/error_view"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone"
            android:padding="40dp">

            <ImageView
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/ic_error_outline"
                android:tint="#FF5252"
                android:layout_gravity="center_horizontal"/>

            <TextView
                android:id="@+id/error_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="加载遇到问题"
                android:textColor="#212121"
                android:textSize="28sp"
                android:textStyle="bold"
                android:layout_gravity="center_horizontal"/>

            <TextView
                android:id="@+id/error_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="正在尝试重新连接..."
                android:textColor="#666666"
                android:textSize="22sp"
                android:lineSpacingMultiplier="1.2"/>

            <TextView
                android:id="@+id/retry_countdown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="10秒后自动重试"
                android:textColor="#888888"
                android:textSize="20sp"
                android:layout_gravity="center_horizontal"/>

            <Button
                android:id="@+id/retry_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="30dp"
                android:text="立即重试"
                android:textSize="20sp"
                android:paddingHorizontal="40dp"
                android:paddingVertical="12dp"
                android:background="@drawable/button_retry_selector"
                android:textColor="#FFFFFF"
                android:layout_gravity="center_horizontal"/>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>